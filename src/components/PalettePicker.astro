---
// Shown only while running `npm run dev`. Lets you try the palettes on the real
// site; the permanent choice is `palette` in src/site.config.ts.
const palettes = ['rangoli', 'chinar', 'riso'];
---

<div class="pp" role="group" aria-label="Try a palette (dev only)">
  <span>palette</span>
  {palettes.map((p) => <button type="button" data-p={p}>{p}</button>)}
</div>

<script is:inline>
  document.querySelectorAll('.pp button').forEach((b) => {
    const sync = () => b.setAttribute('aria-pressed', String(document.documentElement.dataset.palette === b.dataset.p));
    sync();
    b.addEventListener('click', () => {
      document.documentElement.dataset.palette = b.dataset.p;
      try { localStorage.setItem('palette', b.dataset.p); } catch {}
      document.querySelectorAll('.pp button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    });
  });
</script>

<style>
  .pp {
    position: fixed; right: 0.75rem; bottom: 0.75rem; z-index: 50;
    display: flex; align-items: center; gap: 0.25rem;
    padding: 0.3rem 0.4rem 0.3rem 0.7rem;
    background: var(--ink); color: var(--paper);
    border-radius: 999px; font-size: 0.78rem;
  }
  .pp button { border: 0; background: none; color: inherit; padding: 0.3rem 0.6rem; border-radius: 999px; cursor: pointer; }
  .pp button[aria-pressed='true'] { background: var(--paper); color: var(--ink); font-weight: 700; }
</style>
