---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { coverOf, fmtMonth, imagesIn, isoDate } from '../lib/content';

interface Props {
  album: CollectionEntry<'photos'>;
  /** First postcards on the page load eagerly; the rest are lazy. */
  eager?: boolean;
}
const { album, eager = false } = Astro.props;
const { title, date, category, location, cover } = album.data;
const img = coverOf('photos', album.id, cover);
const count = imagesIn('photos', album.id).length;
---

<a class="postcard" href={`/photos/${album.id}/`} data-category={category}>
  <div class="face">
    {img ? (
      <Image
        src={img.src}
        alt=""
        widths={[360, 640, 960]}
        sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 92vw"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
    ) : (
      <div class="blank" aria-hidden="true">
        <svg viewBox="0 0 300 200" preserveAspectRatio="xMidYMid slice">
          <path d="M0 150 70 78l42 44 50-70 56 76 30-30 52 54v48H0z" fill="currentColor" opacity=".3" />
          <path d="M0 176 60 130l50 30 60-44 60 40 70-30v74H0z" fill="currentColor" opacity=".45" />
          <circle cx="232" cy="52" r="22" fill="currentColor" />
        </svg>
        <span class="hand">photos on their way</span>
      </div>
    )}
    <span class="stamp" aria-hidden="true">{category}</span>
  </div>
  <div class="caption">
    <h2 class="hand">{title}</h2>
    <p>
      <time datetime={isoDate(date)}>{fmtMonth(date)}</time>
      {location && <span> · {location}</span>}
      <span class="vh"> · {category}</span>
      {count > 0 && <span> · {count} photo{count === 1 ? '' : 's'}</span>}
    </p>
  </div>
</a>

<style>
  .postcard {
    display: block; text-decoration: none;
    background: #fffdf8; color: var(--ink);
    padding: 0.7rem 0.7rem 0.9rem;
    border: 1.5px solid var(--ink);
    box-shadow: 4px 5px 0 color-mix(in oklab, var(--ink) 22%, transparent);
    transition: rotate 0.18s ease, translate 0.18s ease, box-shadow 0.18s ease;
  }
  .postcard:hover, .postcard:focus-visible { rotate: 0deg !important; translate: 0 -4px; box-shadow: 7px 9px 0 var(--world); }
  .face { position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: var(--paper-2); }
  .face :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .blank { position: absolute; inset: 0; display: grid; place-items: center; background: var(--music); color: var(--projects); }
  .blank svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .blank span { position: relative; background: var(--paper); color: var(--ink); padding: 0.1em 0.6em 0.2em; rotate: -3deg; font-size: 1.3rem; }
  .stamp {
    position: absolute; top: 0.55rem; right: 0.55rem;
    display: grid; place-items: end center;
    width: 3.9rem; aspect-ratio: 4 / 5; padding-bottom: 0.35rem;
    background: var(--world); color: var(--on-world);
    font-size: 0.62rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    border: 1px solid var(--ink);
    /* perforated edge */
    outline: 4px dotted #fffdf8; outline-offset: -2px;
    rotate: 3deg;
  }
  .stamp::before {
    content: ''; position: absolute; left: 50%; top: 22%; translate: -50%;
    width: 44%; aspect-ratio: 1; border-radius: 50%; border: 2px solid currentColor;
  }
  .caption { padding: 0.7rem 0.2rem 0; }
  .caption h2 { font-size: 1.9rem; font-weight: 700; letter-spacing: 0; line-height: 1; }
  .caption p { margin: 0.25rem 0 0; font-size: var(--s-1); color: var(--ink-soft); font-weight: 500; }
</style>
