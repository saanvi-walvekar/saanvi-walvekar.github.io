---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { byNewest, fmtMonth, isoDate } from '../../lib/content';

const pieces = (await getCollection('words')).sort(byNewest);
---

<Base
  world="words"
  title="The Notebook"
  description="Poems and short stories by Saanvi Walvekar."
>
  <div class="wrap">
    <header class="world-head">
      <p class="eyebrow">Poems &amp; stories</p>
      <h1>The Notebook</h1>
    </header>

    <div class="sheet">
      <ol>
        {pieces.map((p) => (
          <li>
            <a href={`/words/${p.id}/`}>
              <span class="title">{p.data.title}</span>
              <span class="meta">{p.data.kind} · <time datetime={isoDate(p.data.date)}>{fmtMonth(p.data.date)}</time></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</Base>


<style>
  ol { list-style: none; margin: 0; padding: 0; }
  a { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; column-gap: 1rem; min-height: var(--line); line-height: var(--line); text-decoration: none; }
  .title { font-family: var(--display); font-style: italic; font-size: 1.45rem; font-weight: 500; }
  a:hover .title { text-decoration: underline; text-decoration-color: var(--world); text-decoration-thickness: 0.1em; }
  .meta { font-size: var(--s-1); font-weight: 600; color: var(--ink-soft); text-transform: capitalize; }
</style>
