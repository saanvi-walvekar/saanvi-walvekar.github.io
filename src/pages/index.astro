---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site, worlds } from '../site.config';
import { byNewest, coverOf, fmtMonth, isoDate } from '../lib/content';

const [photos, projects, music, words, wonders] = await Promise.all([
  getCollection('photos'),
  getCollection('projects'),
  getCollection('music'),
  getCollection('words'),
  getCollection('wonders'),
]);

const plural = (n: number, one: string, many = one + 's') => `${n} ${n === 1 ? one : many}`;
const counts: Record<string, string> = {
  photos: plural(photos.length, 'album'),
  sport: 'Two sports',
  projects: plural(projects.length, 'project'),
  music: music.length ? plural(music.length, 'clip') : 'In progress',
  words: plural(words.length, 'piece'),
  wonders: plural(wonders.length, 'question'),
};

const latest = [
  ...photos.map((e) => ({ date: e.data.date, world: 'photos', title: e.data.title, href: `/photos/${e.id}/` })),
  ...projects.map((e) => ({ date: e.data.date, world: 'projects', title: e.data.title, href: `/projects/${e.id}/` })),
  ...music.map((e) => ({ date: e.data.date, world: 'music', title: e.data.title, href: '/music/' })),
  ...words.map((e) => ({ date: e.data.date, world: 'words', title: e.data.title, href: `/words/${e.id}/` })),
  ...wonders.map((e) => ({ date: e.data.date, world: 'wonders', title: e.data.question, href: `/wonders/${e.id}/` })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 5);

const worldName = (id: string) => worlds.find((w) => w.id === id)!.name;
const [first, ...rest] = site.name.split(' ');

// The Postcards plate shows the cover of the newest album that has photos;
// until one exists it falls back to a drawn plate like the others.
const photoPlate = [...photos]
  .sort(byNewest)
  .map((a) => coverOf('photos', a.id, a.data.cover))
  .find(Boolean);

const updated = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' }).format(new Date());
---

<Base>
  <script is:inline>document.documentElement.classList.add('js');</script>

  <div class="wrap">
    <header class="mast">
      <span>Portfolio</span>
      <span>{site.affiliation}</span>
      <span>Updated {updated}</span>
    </header>

    <section class="hero">
      <h1>
        <span class="line"><span>{first}</span></span>
        <span class="line l2"><em>{rest.join(' ')}</em></span>
      </h1>

      <div class="key" aria-hidden="true">
        {worlds.map((w) => <i data-world={w.id}></i>)}
      </div>

      <div class="stand">
        <p class="intro">{site.intro}</p>
        <div class="else">
          <h2 class="label">Elsewhere</h2>
          <ul>
            {site.links.map((l) => <li><a href={l.href} rel="me">{l.label}</a></li>)}
            {site.resume && <li><a href={site.resume}>Résumé</a></li>}
          </ul>
        </div>
      </div>
    </section>

    <section aria-labelledby="contents-h">
      <header class="sec" data-reveal>
        <h2 id="contents-h" class="label">Contents</h2>
        <span class="label">Six sections</span>
      </header>

      <ul class="feats">
        {worlds.map((w, i) => (
          <li class={`feat f-${w.id}`} data-world={w.id} data-reveal>
            <a href={w.href}>
              <div class="plate">
                {w.id === 'photos' && photoPlate ? (
                  <Image src={photoPlate.src} alt="" widths={[480, 800, 1200]} sizes="(min-width: 56rem) 55vw, 92vw" loading="eager" />
                ) : (
                  <div class="art" aria-hidden="true">
                    {w.id === 'photos' && (
                      <svg viewBox="0 0 120 90" fill="none" stroke="currentColor"><rect x="14" y="12" width="92" height="66" /><circle cx="82" cy="34" r="9" /><path d="M14 66 44 40l16 14 12-10 34 26" /></svg>
                    )}
                    {w.id === 'sport' && (
                      <svg viewBox="0 0 90 120" fill="none" stroke="currentColor"><path d="M8 116V8h74v108" /><path d="M32 8v38h26V8" /><path d="M32 46a13 13 0 0 0 26 0" /><path d="M16 8v14a29 29 0 0 0 58 0V8" /><circle cx="45" cy="16" r="3" /><path d="M8 116h74" /></svg>
                    )}
                    {w.id === 'projects' && (
                      <svg viewBox="0 0 100 100" fill="none" stroke="currentColor"><path d="M20 26 50 48 80 22M50 48 26 80M50 48 78 76M26 80h52" /><g fill="var(--world)"><circle cx="20" cy="26" r="5" /><circle cx="50" cy="48" r="8" /><circle cx="80" cy="22" r="4" /><circle cx="26" cy="80" r="4" /><circle cx="78" cy="76" r="6" /></g></svg>
                    )}
                    {w.id === 'music' && (
                      <svg viewBox="0 0 160 100" fill="none" stroke="currentColor">
                        {Array.from({ length: 16 }, (_, b) => {
                          const group = Math.floor(b / 4);
                          return <circle cx={14 + b * 8.2 + group * 3.2} cy="50" r="2.9" fill={group === 2 ? 'none' : 'currentColor'} />;
                        })}
                        <path d="M10 64h140" />
                      </svg>
                    )}
                    {w.id === 'words' && <p>a line I kept<br />turning over</p>}
                    {w.id === 'wonders' && <span class="q">?</span>}
                  </div>
                )}
              </div>
              <p class="kicker label"><span>0{i + 1}</span>{w.kind}</p>
              <h3>{w.name}</h3>
              <p class="blurb">{w.blurb}</p>
              <p class="count label">{counts[w.id]} <span aria-hidden="true">→</span></p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {latest.length > 0 && (
      <section class="recent" aria-labelledby="recent-h">
        <header class="sec" data-reveal>
          <h2 id="recent-h" class="label">Recently added</h2>
        </header>
        <ol>
          {latest.map((l, i) => (
            <li data-world={l.world} data-reveal style={`--d:${i * 50}ms`}>
              <a href={l.href}>
                <time class="label" datetime={isoDate(l.date)}>{fmtMonth(l.date)}</time>
                <span class="w label">{worldName(l.world)}</span>
                <span class="t">{l.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <p class="closing" data-reveal>
      If something here made you curious, <a href={site.links.find((l) => l.label === 'Email')?.href ?? site.links[0].href}>write to me</a>.
    </p>
  </div>
</Base>

<script>
  // Fade sections in as they scroll into view. Without JS everything is simply visible.
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('in');
        io.unobserve(e.target);
      }),
    { rootMargin: '0px 0px -6% 0px' },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
</script>

<style>
  .label { font-family: var(--sans); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; margin: 0; }

  /* ---------- masthead ---------- */
  .mast { display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.1rem; border-bottom: 1px solid var(--ink); }
  .mast span { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; }
  .mast span:nth-child(3) { display: none; }
  @media (min-width: 40rem) { .mast span:nth-child(3) { display: inline; } }

  /* ---------- hero ---------- */
  .hero { padding-block: clamp(3rem, 9vw, 7.5rem) clamp(3rem, 7vw, 6rem); }
  h1 { font-size: clamp(3.6rem, 14.5vw, 12.5rem); font-weight: 400; line-height: 0.9; letter-spacing: -0.045em; }
  .line { display: block; overflow: clip; overflow-clip-margin: 0.14em; padding-bottom: 0.12em; }
  .line > * { display: inline-block; animation: rise 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .l2 { padding-left: 0.9em; margin-top: -0.06em; }
  .l2 em { font-weight: 300; animation-delay: 0.12s; padding-right: 0.06em; }
  @keyframes rise { from { translate: 0 110%; } }

  /* the only colour in the hero: one hairline in the six section colours */
  .key { display: grid; grid-template-columns: repeat(6, 1fr); height: 5px; margin-top: clamp(2rem, 5vw, 4rem); transform-origin: left; animation: draw 1.2s 0.5s cubic-bezier(0.3, 0.7, 0.2, 1) both; }
  .key i { background: var(--world); }
  @keyframes draw { from { scale: 0 1; } }

  .stand { display: grid; gap: 2.5rem; margin-top: clamp(1.75rem, 4vw, 3rem); animation: fade 1s 0.8s both; }
  .intro { margin: 0; max-width: 36rem; font-family: var(--display); font-weight: 300; font-size: clamp(1.4rem, 2.3vw + 0.6rem, 2.15rem); line-height: 1.32; letter-spacing: -0.015em; }
  .else ul { list-style: none; margin: 0.9rem 0 0; padding: 0; }
  .else li { border-top: 1px solid var(--rule); }
  .else li:last-child { border-bottom: 1px solid var(--rule); }
  .else a { display: flex; justify-content: space-between; padding-block: 0.7rem; text-decoration: none; font-size: 0.98rem; font-weight: 500; transition: padding 0.3s ease; }
  .else a::after { content: '↗'; opacity: 0.45; transition: opacity 0.3s; }
  .else a:hover { padding-left: 0.5rem; }
  .else a:hover::after { opacity: 1; }
  @keyframes fade { from { opacity: 0; translate: 0 0.75rem; } }
  @media (min-width: 56rem) {
    .stand { grid-template-columns: repeat(12, 1fr); column-gap: 1.5rem; }
    .else { grid-column: 1 / 4; grid-row: 1; }
    .intro { grid-column: 6 / 13; grid-row: 1; }
  }

  /* ---------- section header ---------- */
  .sec { display: flex; justify-content: space-between; align-items: baseline; padding-top: 1.1rem; margin-bottom: clamp(2rem, 5vw, 3.5rem); border-top: 1px solid var(--ink); }

  /* ---------- contents: six features, set like magazine openers ---------- */
  .feats { list-style: none; margin: 0; padding: 0; display: grid; gap: 3.5rem; }
  .feat a { display: block; text-decoration: none; }
  .plate { position: relative; aspect-ratio: 5 / 4; overflow: hidden; background: var(--world); color: var(--on-world); }
  .plate :global(img) { width: 100%; height: 100%; object-fit: cover; transition: scale 0.9s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .art { position: absolute; inset: 0; display: grid; place-items: center; transition: scale 0.9s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .art svg { width: 46%; max-height: 62%; stroke-width: 1.1; overflow: visible; }
  .art svg * { vector-effect: non-scaling-stroke; }
  .f-music .art svg { width: 72%; }
  .art p { margin: 0; text-align: center; font-family: var(--display); font-style: italic; font-weight: 300; font-size: clamp(1.5rem, 7cqi, 2.6rem); line-height: 1.25; padding-block: 1.1em; border-block: 1px solid currentColor; }
  .q { font-family: var(--display); font-style: italic; font-weight: 200; font-size: clamp(9rem, 46cqi, 20rem); line-height: 1; }
  .plate { container-type: inline-size; }
  .feat a:hover .art, .feat a:hover .plate :global(img) { scale: 1.045; }

  .kicker { display: flex; gap: 1.1rem; margin-top: 1.1rem; }
  .kicker span { font-variant-numeric: tabular-nums; }
  .feat h3 { font-size: clamp(2.2rem, 4.4vw + 0.8rem, 4.2rem); font-weight: 400; letter-spacing: -0.035em; line-height: 1; margin: 0.6rem 0 0.7rem; }
  .feat h3 { background: linear-gradient(var(--world), var(--world)) no-repeat 0 100% / 0% 2px; width: fit-content; padding-bottom: 0.08em; transition: background-size 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .feat a:hover h3, .feat a:focus-visible h3 { background-size: 100% 2px; }
  .blurb { margin: 0; max-width: 26rem; color: var(--ink-soft); }
  .count { margin-top: 1rem; display: flex; gap: 0.6rem; align-items: center; }
  .count span { transition: translate 0.4s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .feat a:hover .count span { translate: 0.4rem 0; }

  @media (min-width: 56rem) {
    .feats { grid-template-columns: repeat(12, 1fr); column-gap: 1.5rem; row-gap: clamp(4rem, 8vw, 7rem); }
    .f-photos { grid-column: 1 / 8; }
    .f-photos .plate { aspect-ratio: 4 / 3; }
    .f-sport { grid-column: 9 / 13; margin-top: 9rem; }
    .f-sport .plate { aspect-ratio: 3 / 4; }
    .f-projects { grid-column: 2 / 6; }
    .f-projects .plate { aspect-ratio: 1; }
    .f-music { grid-column: 7 / 13; margin-top: 6rem; }
    .f-music .plate { aspect-ratio: 16 / 10; }
    .f-words { grid-column: 1 / 5; margin-top: -3rem; }
    .f-words .plate { aspect-ratio: 4 / 5; }
    .f-wonders { grid-column: 6 / 13; margin-top: 4rem; }
    .f-wonders .plate { aspect-ratio: 4 / 3; }
  }

  /* ---------- reveal on scroll (only when JS is on) ---------- */
  .js [data-reveal] { opacity: 0; translate: 0 1.75rem; }
  .js [data-reveal].in { opacity: 1; translate: 0 0; transition: opacity 0.9s var(--d, 0ms) ease, translate 1s var(--d, 0ms) cubic-bezier(0.2, 0.7, 0.2, 1); }
  .js .feat .plate { clip-path: inset(0 0 100% 0); }
  .js .feat.in .plate { clip-path: inset(0); transition: clip-path 1.2s cubic-bezier(0.3, 0.7, 0.1, 1); }

  /* ---------- recently added ---------- */
  .recent { margin-top: clamp(5rem, 11vw, 9rem); }
  .recent .sec { margin-bottom: 0; padding-bottom: 1.1rem; }
  .recent ol { list-style: none; margin: 0; padding: 0; }
  .recent a { display: grid; grid-template-columns: 1fr; gap: 0.3rem 1.5rem; padding-block: 1.15rem; border-top: 1px solid var(--rule); text-decoration: none; align-items: baseline; }
  .recent li:last-child a { border-bottom: 1px solid var(--rule); }
  .recent time { color: var(--ink-soft); }
  .recent .w { display: flex; align-items: center; gap: 0.6em; }
  .recent .w::before { content: ''; width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--world); }
  .recent a { grid-template-columns: auto 1fr; }
  .recent .t { grid-column: 1 / -1; font-family: var(--display); font-weight: 400; font-size: clamp(1.35rem, 2vw + 0.7rem, 2rem); line-height: 1.2; letter-spacing: -0.015em; transition: translate 0.4s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .recent a:hover .t { translate: 0.6rem 0; }
  @media (min-width: 56rem) {
    .recent a { grid-template-columns: repeat(12, 1fr); }
    .recent time { grid-column: 1 / 3; }
    .recent .w { grid-column: 3 / 6; }
    .recent .t { grid-column: 6 / 13; }
  }

  /* ---------- closing ---------- */
  .closing { margin: clamp(5rem, 11vw, 9rem) 0 0; max-width: 46rem; font-family: var(--display); font-weight: 300; font-size: clamp(1.9rem, 3.6vw + 0.8rem, 3.6rem); line-height: 1.12; letter-spacing: -0.03em; }
  .closing a { font-style: italic; text-decoration-thickness: 2px; text-decoration-color: var(--photos); text-underline-offset: 0.14em; }
</style>
