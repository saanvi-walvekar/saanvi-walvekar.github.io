---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, worlds } from '../site.config';
import { fmtMonth, isoDate } from '../lib/content';

const [photos, projects, music, words, wonders] = await Promise.all([
  getCollection('photos'),
  getCollection('projects'),
  getCollection('music'),
  getCollection('words'),
  getCollection('wonders'),
]);

const plural = (n: number, one: string, many = one + 's') => `${n} ${n === 1 ? one : many}`;
const counts: Record<string, string> = {
  photos: plural(photos.length, 'album'),
  sport: 'two sports',
  projects: plural(projects.length, 'project'),
  music: music.length ? plural(music.length, 'clip') : 'tuning up',
  words: plural(words.length, 'piece'),
  wonders: plural(wonders.length, 'question'),
};

const latest = [
  ...photos.map((e) => ({ date: e.data.date, world: 'photos', title: e.data.title, href: `/photos/${e.id}/` })),
  ...projects.map((e) => ({ date: e.data.date, world: 'projects', title: e.data.title, href: `/projects/${e.id}/` })),
  ...music.map((e) => ({ date: e.data.date, world: 'music', title: e.data.title, href: '/music/' })),
  ...words.map((e) => ({ date: e.data.date, world: 'words', title: e.data.title, href: `/words/${e.id}/` })),
  ...wonders.map((e) => ({ date: e.data.date, world: 'wonders', title: e.data.question, href: `/wonders/${e.id}/` })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 6);

const worldName = (id: string) => worlds.find((w) => w.id === id)!.name;
const [first, ...rest] = site.name.split(' ');
const beats = Array.from({ length: 16 }, (_, i) => i);

// The rolling line under the name: one phrase per world.
const does = [
  { world: 'photos', text: 'takes photographs' },
  { world: 'sport', text: 'plays basketball' },
  { world: 'music', text: 'plays the tabla' },
  { world: 'words', text: 'writes poems' },
  { world: 'projects', text: 'optimises things' },
  { world: 'wonders', text: 'asks too many questions' },
  { world: 'sport', text: 'runs track' },
];
const ticker = ['Photographs', 'Basketball', 'Athletics', 'Tabla', 'Poems', 'Operations research', 'Questions'];
---

<Base footLinks={false}>
  <script is:inline>document.documentElement.classList.add('js');</script>

  <section class="hero wrap">
    <div class="shapes" aria-hidden="true">
      <i class="s sun"></i>
      <i class="s ring"></i>
      <i class="s dots"></i>
      <svg class="s squiggle" viewBox="0 0 220 60" fill="none"><path d="M4 30c18-34 36-34 54 0s36 34 54 0 36-34 54 0 36 34 50 4" stroke="currentColor" stroke-width="9" stroke-linecap="round" /></svg>
      <svg class="s star" viewBox="0 0 100 100"><path d="M50 2l9 30 30-12-17 27 26 17-31 4 3 31-20-23-20 23 3-31-31-4 26-17-17-27 30 12z" fill="currentColor" /></svg>
    </div>

    <h1>
      <span class="line"><span class="l1">{first}</span></span>
      <span class="line"><span class="l2">{rest.join(' ')}</span></span>
    </h1>

    <p class="does">
      <span class="vh">who {does.map((d) => d.text).join(', ')}.</span>
      <span aria-hidden="true">who</span>
      <span class="roll" aria-hidden="true">
        <span class="reel">
          {[...does, does[0]].map((d) => <span data-world={d.world}><b>{d.text}</b></span>)}
        </span>
      </span>
    </p>

    <svg class="badge" viewBox="0 0 120 120" aria-hidden="true">
      <defs><path id="circ" d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0" /></defs>
      <circle cx="60" cy="60" r="58" />
      <text><textPath href="#circ" textLength="270">IEOR · IIT BOMBAY · IEOR · IIT BOMBAY ·</textPath></text>
      <path class="pip" d="M60 40l5 15 15 5-15 5-5 15-5-15-15-5 15-5z" />
    </svg>

    <div class="about">
      <p>{site.intro}</p>
      <ul>
        {site.links.map((l) => <li><a href={l.href} rel="me">{l.label}</a></li>)}
        {site.resume && <li><a href={site.resume}>Résumé</a></li>}
      </ul>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => (
        <ul>
          {ticker.map((t, i) => (
            <li>
              {t}
              <svg viewBox="0 0 100 100" style={`--c:var(--${worlds[i % worlds.length].id})`}><path d="M50 2l9 30 30-12-17 27 26 17-31 4 3 31-20-23-20 23 3-31-31-4 26-17-17-27 30 12z" /></svg>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <section class="wrap" aria-labelledby="worlds-h">
    <header class="sec-head" data-reveal>
      <h2 id="worlds-h">Pick a world<i>.</i></h2>
      <p class="hand">six of them, all mine</p>
    </header>

    <ul class="worlds">
      {worlds.map((w, i) => (
        <li class={`tile t-${w.id}`} data-world={w.id} data-reveal>
          <a href={w.href}>
            <div class="face">
              <div class="art" aria-hidden="true">
                {w.id === 'photos' && (
                  <div class="pc">
                    <div class="pc-img">
                      <i class="pc-sun"></i>
                      <svg viewBox="0 0 120 80" preserveAspectRatio="none"><path class="m1" d="M0 80V52l26-26 20 22 18-24 26 34 30-20v42z" /><path class="m2" d="M0 80V64l34-22 22 16 26-22 38 26v18z" /></svg>
                    </div>
                    <div class="pc-back"><span class="stamp"></span><i></i><i></i><i></i></div>
                  </div>
                )}
                {w.id === 'sport' && (
                  <>
                    <svg class="court" viewBox="0 0 200 150" fill="none" stroke="currentColor" stroke-width="2.4">
                      <path d="M10 150V10h180v140" /><path d="M70 10v66h60V10" /><path d="M70 76a30 30 0 0 0 60 0" /><path d="M70 76a30 30 0 0 1 60 0" stroke-dasharray="5 5" />
                      <path d="M28 10v32a72 72 0 0 0 144 0V10" /><path d="M88 22h24" stroke-width="4" /><circle cx="100" cy="29" r="5" />
                    </svg>
                    <span class="ball"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2"><circle cx="20" cy="20" r="18" fill="var(--paper)" /><path d="M2 20h36M20 2v36M7 7c7 7 7 19 0 26M33 7c-7 7-7 19 0 26" /></svg></span>
                  </>
                )}
                {w.id === 'projects' && (
                  <svg class="net" viewBox="0 0 200 130" fill="none">
                    <g class="edges" stroke="var(--ink)" stroke-width="2"><path pathLength="1" d="M34 34 96 62" /><path pathLength="1" d="M96 62 160 28" /><path pathLength="1" d="M96 62 48 106" /><path pathLength="1" d="M96 62 162 102" /><path pathLength="1" d="M48 106h114" /></g>
                    <g class="nodes" stroke="var(--ink)" stroke-width="2"><circle cx="34" cy="34" r="9" fill="var(--photos)" /><circle cx="96" cy="62" r="15" fill="var(--projects)" /><circle cx="160" cy="28" r="8" fill="var(--music)" /><circle cx="48" cy="106" r="8" fill="var(--wonders)" /><circle cx="162" cy="102" r="11" fill="var(--sport)" /></g>
                  </svg>
                )}
                {w.id === 'music' && (
                  <div class="beats">{beats.map((b) => <i class:list={{ khali: b >= 8 && b < 12 }} style={`--i:${b}`} />)}</div>
                )}
                {w.id === 'words' && <p class="hand"><span>a line I kept</span><span>turning over —</span></p>}
                {w.id === 'wonders' && <span class="q">?</span>}
              </div>
              <span class="no" aria-hidden="true">{i + 1}</span>
              <div class="meta">
                <h3>{w.name}</h3>
                <p>{w.kind} · {counts[w.id]}</p>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {latest.length > 0 && (
    <section class="wrap latest" aria-labelledby="latest-h">
      <header class="sec-head" data-reveal>
        <h2 id="latest-h">Lately<i>.</i></h2>
        <p class="hand">what I added last</p>
      </header>
      <ol>
        {latest.map((l, i) => (
          <li data-world={l.world} data-reveal style={`--d:${i * 60}ms`}>
            <a href={l.href}>
              <time datetime={isoDate(l.date)}>{fmtMonth(l.date)}</time>
              <span class="w">{worldName(l.world)}</span>
              <span class="t">{l.title}</span>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="wrap hi" aria-labelledby="hi-h">
    <p class="hand" id="hi-h" data-reveal>say hi —</p>
    <ul>
      {site.links.map((l, i) => (
        <li data-world={worlds[i % worlds.length].id} data-reveal style={`--d:${i * 70}ms`}>
          <a href={l.href} rel="me">{l.label}<span aria-hidden="true">↗</span></a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  // Reveal on scroll. Content is fully visible without JS (the .js class gates the hidden state).
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('in');
        io.unobserve(e.target);
      }),
    { rootMargin: '0px 0px -8% 0px' },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

  // The printed shapes drift a little with the pointer (mouse only, and not if motion is reduced).
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero && matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    let frame = 0;
    addEventListener(
      'pointermove',
      (e) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          hero.style.setProperty('--mx', (e.clientX / innerWidth - 0.5).toFixed(3));
          hero.style.setProperty('--my', (e.clientY / innerHeight - 0.5).toFixed(3));
        });
      },
      { passive: true },
    );
  }
</script>

<style>
  /* ============ hero: a riso print, slightly off-register ============ */
  .hero {
    --mx: 0; --my: 0;
    position: relative; isolation: isolate;
    padding-block: clamp(2.5rem, 9vw, 6.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  h1 { font-size: clamp(4rem, 17.5vw, 15rem); font-weight: 800; line-height: 0.84; letter-spacing: -0.055em; }
  .line { display: block; overflow: clip; overflow-clip-margin: 0.12em; padding-block: 0.02em 0.1em; }
  .line > span { display: inline-block; animation: rise 0.9s cubic-bezier(0.2, 0.9, 0.2, 1) both; }
  .line:nth-child(2) > span { animation-delay: 0.12s; }
  .l1 { text-shadow: 0.045em 0.04em 0 var(--photos); }
  .l2 {
    font-style: italic; font-weight: 600; margin-left: 0.42em; padding-right: 0.08em;
    color: transparent; -webkit-text-stroke: 0.018em var(--ink);
    text-shadow: -0.03em 0.035em 0 var(--projects);
  }
  @keyframes rise { from { translate: 0 105%; rotate: 4deg; } }

  .does {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.2em 0.45em;
    margin: clamp(1rem, 3vw, 2rem) 0 0;
    font-family: var(--display); font-size: clamp(1.45rem, 4.6vw, 3rem); font-weight: 500; font-style: italic; line-height: 1.3;
    animation: fade 0.8s 0.5s both;
  }
  .roll { display: inline-block; height: 1.3em; overflow: hidden; }
  .reel { display: flex; flex-direction: column; animation: roll 17.5s cubic-bezier(0.7, 0, 0.2, 1) infinite; }
  .reel span { height: 1.3em; white-space: nowrap; }
  .reel b { font-weight: 700; font-style: normal; background: var(--world); color: var(--on-world); padding: 0 0.3em; box-decoration-break: clone; }
  @keyframes roll {
    0%, 11% { translate: 0 0; }
    14.3%, 25.3% { translate: 0 -1.3em; }
    28.6%, 39.6% { translate: 0 -2.6em; }
    42.9%, 53.9% { translate: 0 -3.9em; }
    57.2%, 68.2% { translate: 0 -5.2em; }
    71.5%, 82.5% { translate: 0 -6.5em; }
    85.8%, 96.8% { translate: 0 -7.8em; }
    100% { translate: 0 -9.1em; }
  }
  @keyframes fade { from { opacity: 0; translate: 0 0.6rem; } }

  .about { margin-top: clamp(1.75rem, 4vw, 3rem); max-width: 33rem; font-size: var(--s1); line-height: 1.45; animation: fade 0.8s 0.7s both; }
  .about ul { display: flex; flex-wrap: wrap; gap: 0.1rem 1.4rem; list-style: none; padding: 0; margin: 0; font-size: 1rem; font-weight: 700; }
  .about li:nth-child(4n + 1) { --world: var(--projects); }
  .about li:nth-child(4n + 2) { --world: var(--photos); }
  .about li:nth-child(4n + 3) { --world: var(--wonders); }
  .about li:nth-child(4n) { --world: var(--sport); }
  .about a { display: inline-block; padding-block: 0.6rem; }

  /* printed shapes: flat inks that overprint (multiply) where they cross */
  .shapes { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .s { position: absolute; mix-blend-mode: multiply; translate: calc(var(--mx) * var(--k, 20) * 1px) calc(var(--my) * var(--k, 20) * 1px); transition: translate 0.5s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .sun { --k: -34; right: -3%; top: 3%; width: clamp(11rem, 40vw, 30rem); aspect-ratio: 1; border-radius: 50%; background: var(--music); animation: pop 1s 0.15s cubic-bezier(0.2, 1.3, 0.4, 1) both, bob 9s 1.2s ease-in-out infinite alternate; }
  .ring { --k: 46; right: 20%; top: clamp(8rem, 26vw, 19rem); width: clamp(6.5rem, 19vw, 14rem); aspect-ratio: 1; border-radius: 50%; border: clamp(1.1rem, 3.2vw, 2.4rem) solid var(--projects); animation: pop 1s 0.35s cubic-bezier(0.2, 1.3, 0.4, 1) both, bob 7s 1.4s ease-in-out infinite alternate-reverse; }
  .dots { --k: 22; right: 3%; bottom: 6%; width: clamp(8rem, 26vw, 19rem); aspect-ratio: 5 / 3; rotate: -8deg; background: radial-gradient(circle, var(--photos) 34%, transparent 36%) 0 0 / 0.8rem 0.8rem; animation: fade 1s 0.6s both; }
  .squiggle { --k: -18; color: var(--wonders); width: clamp(7rem, 18vw, 13rem); left: 44%; bottom: 3%; rotate: -6deg; animation: fade 1s 0.8s both; }
  .star { --k: 60; color: var(--sport); width: clamp(2.6rem, 6vw, 4.6rem); left: clamp(11.5rem, 47vw, 39rem); top: clamp(1rem, 4vw, 3rem); animation: pop 0.8s 0.9s cubic-bezier(0.2, 1.5, 0.4, 1) both, spin 24s linear infinite; }
  @keyframes pop { from { scale: 0; } }
  @keyframes bob { to { transform: translateY(-14px) rotate(3deg); } }
  @keyframes spin { to { transform: rotate(360deg); } }

  .badge {
    position: absolute; right: clamp(0.25rem, 6vw, 6rem); top: clamp(9.5rem, 30vw, 21rem);
    width: clamp(5.6rem, 13vw, 9rem); rotate: 12deg;
    animation: pop 0.8s 1s cubic-bezier(0.2, 1.4, 0.4, 1) both;
  }
  .badge circle { fill: var(--ink); }
  .badge text { fill: var(--paper); font: 700 12.5px var(--sans); letter-spacing: 0.08em; transform-origin: 60px 60px; animation: spin 26s linear infinite; }
  .badge .pip { fill: var(--music); }

  /* on wide screens the badge sits beside the intro, clear of the name */
  @media (min-width: 48rem) { .badge { top: auto; bottom: clamp(4rem, 11vw, 9rem); right: clamp(2rem, 9vw, 9rem); } }
  @media (max-width: 47.99rem) {
    .badge { top: 10.75rem; }
    .dots, .squiggle { display: none; }
    .ring { right: 34%; }
  }

  /* ============ ticker ============ */
  .ticker { width: 106vw; margin-left: -3vw; rotate: -1.6deg; background: var(--ink); color: var(--paper); overflow: hidden; border-block: 2px solid var(--ink); }
  .track { display: flex; width: max-content; animation: slide 36s linear infinite; }
  .ticker:hover .track { animation-play-state: paused; }
  .ticker ul { display: flex; list-style: none; margin: 0; padding: 0; }
  .ticker li { display: flex; align-items: center; gap: 1.1rem; padding: 0.7rem 0 0.75rem 1.1rem; font-family: var(--display); font-style: italic; font-weight: 600; font-size: clamp(1.25rem, 3.2vw, 2rem); white-space: nowrap; }
  .ticker svg { width: 0.9em; fill: var(--c); animation: spin 8s linear infinite; }
  @keyframes slide { to { translate: -50% 0; } }

  /* ============ section headings ============ */
  .sec-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1.25rem; margin: clamp(3.5rem, 9vw, 7rem) 0 clamp(1.5rem, 4vw, 2.75rem); }
  .sec-head h2 { font-size: clamp(2.6rem, 9vw, 6rem); font-weight: 700; letter-spacing: -0.04em; line-height: 0.95; }
  .sec-head h2 i { font-style: normal; color: var(--photos); }
  .sec-head .hand { margin: 0; font-size: clamp(1.4rem, 3vw, 2rem); rotate: -3deg; color: var(--projects); font-weight: 700; }

  /* ============ the six worlds: a pinned-up collage ============ */
  .worlds { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.6rem; }
  .tile { --r: 0deg; min-width: 0; rotate: var(--r); container-type: inline-size; }
  .tile:nth-child(odd) { --r: -1.1deg; margin-right: 5%; }
  .tile:nth-child(even) { --r: 1.2deg; margin-left: 5%; }
  .tile a { position: relative; display: block; height: 100%; text-decoration: none; color: var(--on-world); transition: translate 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.3), rotate 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.3); }
  /* the ink outline is printed a few pixels off the colour block; hovering snaps it into register */
  .tile a::after { content: ''; position: absolute; inset: 0; border: 2px solid var(--ink); border-radius: 10px; translate: 7px 7px; pointer-events: none; transition: translate 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.3); }
  .tile a:hover, .tile a:focus-visible { translate: 0 -6px; rotate: calc(var(--r) * -0.6); }
  .tile a:hover::after, .tile a:focus-visible::after { translate: 0 0; }
  .face { position: relative; display: flex; flex-direction: column; justify-content: flex-end; height: 100%; min-height: 15.5rem; padding: 1.15rem; overflow: hidden; border-radius: 10px; background: var(--world); }
  /* halftone shading in one corner */
  .face::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle, color-mix(in oklab, var(--ink) 30%, transparent) 30%, transparent 33%) 0 0 / 0.5rem 0.5rem; -webkit-mask-image: linear-gradient(20deg, #000, transparent 45%); mask-image: linear-gradient(20deg, #000, transparent 45%); pointer-events: none; }
  .art { position: absolute; inset: 0; pointer-events: none; }
  .no { position: absolute; top: 0.4rem; left: 1rem; font-family: var(--display); font-style: italic; font-weight: 800; font-size: 3.4rem; line-height: 1; color: transparent; -webkit-text-stroke: 1.5px var(--on-world); opacity: 0.9; }
  .meta { position: relative; }
  .meta h3 { font-size: clamp(1.9rem, 11cqi, 3.6rem); font-weight: 700; letter-spacing: -0.03em; line-height: 0.95; margin-bottom: 0.4rem; }
  .meta p { margin: 0; font-size: 0.95rem; font-weight: 600; }

  /* --- postcards --- */
  .t-photos .face { min-height: 21rem; }
  .pc { position: absolute; right: 5%; top: 8%; width: min(76%, 32rem); aspect-ratio: 3 / 2; display: grid; grid-template-columns: 1.15fr 1fr; background: var(--paper); color: var(--ink); border: 2px solid var(--ink); rotate: 5deg; box-shadow: 6px 7px 0 color-mix(in oklab, var(--ink) 40%, transparent); transition: rotate 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.3), translate 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.3); }
  .tile a:hover .pc { rotate: -3deg; translate: -3% -4%; }
  .pc-img { position: relative; margin: 6%; background: color-mix(in oklab, var(--music) 35%, var(--paper)); overflow: hidden; }
  .pc-sun { position: absolute; right: 14%; top: 12%; width: 26%; aspect-ratio: 1; border-radius: 50%; background: var(--sport); }
  .pc-img svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pc-img path { mix-blend-mode: multiply; }
  .m1 { fill: var(--projects); }
  .m2 { fill: var(--music); }
  .pc-back { border-left: 1.5px solid var(--rule); padding: 12% 10%; display: flex; flex-direction: column; justify-content: flex-end; gap: 14%; }
  .pc-back i { height: 1.5px; background: var(--ink); opacity: 0.45; }
  .stamp { position: absolute; top: 9%; right: 4.5%; width: 15%; aspect-ratio: 4 / 5; background: var(--wonders); outline: 3px dotted var(--paper); outline-offset: -1px; border: 1px solid var(--ink); }
  .tile a:hover .stamp { animation: wiggle 0.5s ease-in-out; }
  @keyframes wiggle { 30% { rotate: -10deg; } 65% { rotate: 7deg; } }

  /* --- court & track --- */
  .court { position: absolute; top: -8%; right: 6%; width: min(62%, 17rem); opacity: 0.85; }
  .ball { position: absolute; right: calc(6% + min(31%, 8.5rem) - 1.4rem); top: 9%; width: 2.8rem; }
  .tile.in .ball { animation: bounce 0.55s cubic-bezier(0.45, 0, 0.9, 0.55) 8 alternate; }
  .tile a:hover .ball { animation: bounce 0.5s cubic-bezier(0.45, 0, 0.9, 0.55) infinite alternate; }
  @keyframes bounce { to { translate: 0 5.2rem; } }

  /* --- the network: on graph paper, edges draw themselves in --- */
  .t-projects a { color: var(--ink); }
  .t-projects .face { background-color: var(--paper); background-image: linear-gradient(color-mix(in oklab, var(--projects) 28%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in oklab, var(--projects) 28%, transparent) 1px, transparent 1px); background-size: 20px 20px; }
  .t-projects .face::before { display: none; }
  .t-projects .no { -webkit-text-stroke-color: var(--projects); }
  .net { position: absolute; right: 4%; top: 6%; width: min(68%, 22rem); }
  .edges path { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .tile.in .edges path { animation: draw 0.7s ease-out forwards; }
  .edges path:nth-child(2) { animation-delay: 0.15s !important; }
